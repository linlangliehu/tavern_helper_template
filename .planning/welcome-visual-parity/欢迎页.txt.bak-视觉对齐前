<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>魔法禁书目录</title>
<style>
/* ===== 魔法禁书目录·开局设定（原创实现，深蓝科幻霓虹）===== */
:root {
  --mw-bg-a: #0a0a2a;
  --mw-bg-b: #1a1a4a;
  --mw-glow: rgba(100, 200, 255, 0.5);
  --mw-accent: #66ccff;
  --mw-accent-2: #3399ff;
  --mw-cyan: #00ffaa;
  --mw-text: #e8f4ff;
  --mw-dim: #99ddff;
  --mw-card: rgba(18, 24, 66, 0.72);
  --mw-line: rgba(102, 204, 255, 0.28);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { width: 100%; min-height: 100%; }
body {
  background: linear-gradient(135deg, var(--mw-bg-a), var(--mw-bg-b), var(--mw-bg-a)) fixed;
  color: var(--mw-text);
  font-family: "PingFang SC", "Microsoft YaHei", -apple-system, sans-serif;
  font-size: 14px;
  line-height: 1.6;
  overflow-x: hidden;
}
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-thumb { background: rgba(102,204,255,.35); border-radius: 4px; }

/* ---- 顶部导航 ---- */
.mw-nav {
  position: sticky; top: 0; z-index: 50;
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 10px 14px;
  background: rgba(8, 8, 32, 0.9);
  border-bottom: 1px solid var(--mw-line);
  backdrop-filter: blur(6px);
}
.mw-brand {
  font-weight: 700; letter-spacing: 2px;
  background: linear-gradient(to right, var(--mw-accent), var(--mw-accent-2));
  -webkit-background-clip: text; background-clip: text; color: transparent;
  white-space: nowrap;
}
.mw-navtabs { display: flex; gap: 6px; }
.mw-navtab {
  padding: 7px 16px; border-radius: 999px; cursor: pointer;
  border: 1px solid var(--mw-line); background: transparent; color: var(--mw-dim);
  font-size: 13px; transition: all .2s;
}
.mw-navtab:hover { color: var(--mw-text); border-color: var(--mw-accent); }
.mw-navtab.active {
  color: #06122b; font-weight: 600;
  background: linear-gradient(to right, var(--mw-accent), var(--mw-accent-2));
  border-color: transparent;
}

/* ---- 页面容器 ---- */
.mw-page { display: none; max-width: 720px; margin: 0 auto; padding: 20px 14px 90px; }
.mw-page.active { display: block; animation: mwFade .35s ease; }
@keyframes mwFade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

.mw-title {
  text-align: center; font-size: 30px; letter-spacing: 12px; font-weight: 800;
  margin: 14px 0 4px;
  text-shadow: 0 0 18px var(--mw-glow), 0 0 42px rgba(51,153,255,.4);
}
.mw-slogan { text-align: center; color: var(--mw-dim); font-size: 13px; margin-bottom: 26px; }
.mw-slogan .em { color: var(--mw-accent); }

/* ---- 区块 ---- */
.mw-sec {
  background: var(--mw-card);
  border: 1px solid var(--mw-line);
  border-radius: 14px;
  padding: 16px 16px 18px;
  margin-bottom: 16px;
  box-shadow: 0 12px 34px rgba(0, 8, 30, 0.45);
}
.mw-sec h2 { font-size: 17px; letter-spacing: 3px; text-align: center; margin-bottom: 14px; color: var(--mw-accent); }
.mw-sec h3 { font-size: 15px; letter-spacing: 2px; margin: 4px 0 12px; color: var(--mw-accent); }
.mw-sec h4 { font-size: 13.5px; letter-spacing: 1.5px; margin: 16px 0 10px; color: var(--mw-dim); }
.mw-hint { font-size: 11.5px; color: var(--mw-dim); opacity: .85; margin: -6px 0 12px; }
.mw-backlink {
  display: inline-block; font-size: 12px; color: var(--mw-accent);
  cursor: pointer; margin-bottom: 8px; user-select: none;
}
.mw-backlink:hover { text-decoration: underline; }

/* ---- 表单 ---- */
.mw-row { margin-bottom: 12px; }
.mw-label { display: block; font-size: 12.5px; color: var(--mw-dim); margin-bottom: 5px; }
.mw-input, .mw-select, .mw-textarea {
  width: 100%; padding: 9px 12px; font-size: 13.5px;
  color: var(--mw-text); background: rgba(8, 14, 44, 0.65);
  border: 1px solid var(--mw-line); border-radius: 9px; outline: none;
  font-family: inherit; transition: border-color .2s, box-shadow .2s;
}
.mw-input:focus, .mw-select:focus, .mw-textarea:focus {
  border-color: var(--mw-accent);
  box-shadow: 0 0 0 2px rgba(102, 204, 255, 0.18);
}
.mw-textarea { resize: vertical; min-height: 58px; }
.mw-select option { background: #101838; color: var(--mw-text); }
.mw-duo { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

/* ---- 阵营卡片 ---- */
.mw-side-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.mw-side-card {
  position: relative; cursor: pointer; text-align: center;
  border: 1px solid var(--mw-line); border-radius: 12px;
  background: linear-gradient(135deg, rgba(0,30,60,.55), rgba(0,50,100,.5));
  padding: 18px 12px 15px; transition: all .2s;
}
.mw-side-card:hover { transform: translateY(-2px); border-color: var(--mw-accent); }
.mw-side-card.selected {
  border-color: transparent;
  background:
    linear-gradient(var(--mw-card), var(--mw-card)) padding-box,
    linear-gradient(to right, var(--mw-accent), var(--mw-accent-2)) border-box;
  border: 1px solid transparent;
  box-shadow: 0 0 0 1px rgba(102,204,255,.4), 0 10px 30px rgba(20,80,160,.35);
}
.mw-side-ico { font-size: 26px; margin-bottom: 6px; }
.mw-side-name { font-size: 15.5px; font-weight: 700; letter-spacing: 2px; color: var(--mw-text); }
.mw-side-desc { font-size: 11.5px; color: var(--mw-dim); margin-top: 6px; min-height: 34px; }

/* ---- 选项网格 ---- */
.mw-opts { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 8px; }
.mw-opt {
  padding: 9px 6px; font-size: 12.5px; text-align: center; cursor: pointer;
  color: var(--mw-text); background: rgba(10, 18, 52, 0.7);
  border: 1px solid var(--mw-line); border-radius: 9px;
  transition: all .18s; word-break: break-all; font-family: inherit;
}
.mw-opt small { display: block; font-size: 10px; color: var(--mw-cyan); margin-top: 2px; }
.mw-opt:hover { border-color: var(--mw-accent); background: rgba(102,204,255,.12); }
.mw-opt.selected {
  color: #06122b; font-weight: 600;
  background: linear-gradient(to right, var(--mw-accent), var(--mw-accent-2));
  border-color: transparent;
}
.mw-opt.selected small { color: #06264a; }
.mw-opt.locked { opacity: .3; cursor: not-allowed; }
.mw-custom-box { display: none; margin-top: 8px; }

/* ---- 开场白卡片 ---- */
.mw-scenes { display: flex; flex-direction: column; gap: 8px; max-height: 420px; overflow-y: auto; padding-right: 4px; }
.mw-scene {
  cursor: pointer; padding: 10px 12px;
  border: 1px solid var(--mw-line); border-left: 3px solid var(--mw-accent-2);
  border-radius: 9px; background: rgba(10, 16, 48, 0.66);
  transition: all .18s;
}
.mw-scene:hover { border-color: var(--mw-accent); background: rgba(102,204,255,.08); }
.mw-scene.selected {
  background: linear-gradient(135deg, rgba(102,204,255,.16), rgba(51,153,255,.12));
  border-color: var(--mw-accent);
}
.mw-scene-head { display: flex; align-items: center; gap: 8px; margin-bottom: 3px; }
.mw-scene-date { font-weight: 700; color: var(--mw-accent); font-size: 13px; }
.mw-scene-tag {
  font-size: 10.5px; color: var(--mw-cyan);
  border: 1px solid rgba(0,255,170,.4); border-radius: 999px; padding: 1px 8px;
}
.mw-scene-desc { font-size: 12px; color: var(--mw-dim); }

/* ---- 主按钮 ---- */
.mw-gen-btn {
  display: block; width: 100%; margin-top: 14px; padding: 12px;
  font-size: 15px; font-weight: 700; letter-spacing: 4px; cursor: pointer;
  color: #06122b; border: none; border-radius: 11px; font-family: inherit;
  background: linear-gradient(to right, var(--mw-accent), var(--mw-accent-2));
  box-shadow: 0 8px 24px rgba(40, 120, 220, 0.4);
  transition: all .2s;
}
.mw-gen-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 30px rgba(40,140,255,.5); }
.mw-gen-btn:disabled { opacity: .38; cursor: not-allowed; box-shadow: none; }

/* ---- 角色介绍 ---- */
.mw-intro-tip { text-align: center; color: var(--mw-dim); font-size: 12.5px; margin-bottom: 16px; }
.mw-char-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 10px; }
.mw-char-tile {
  cursor: pointer; text-align: center; padding: 14px 6px 10px;
  border: 1px solid var(--mw-line); border-radius: 12px;
  background: rgba(12, 18, 52, 0.72); transition: all .2s;
}
.mw-char-tile:hover { transform: translateY(-3px); border-color: var(--mw-accent); box-shadow: 0 8px 22px rgba(20,90,180,.35); }
.mw-char-face {
  width: 54px; height: 54px; line-height: 54px; margin: 0 auto 8px;
  border-radius: 50%; font-size: 22px; font-weight: 700; color: #06122b;
  background: radial-gradient(circle at 30% 25%, var(--mw-glow), transparent 60%),
              linear-gradient(135deg, var(--mw-accent), var(--mw-accent-2));
}
.mw-char-nm { font-size: 13px; font-weight: 600; }
.mw-char-tag { font-size: 10.5px; color: var(--mw-dim); margin-top: 2px; }

/* ---- 弹窗 ---- */
.mw-modal-mask {
  display: none; position: fixed; inset: 0; z-index: 200;
  background: rgba(2, 4, 18, 0.78); backdrop-filter: blur(3px);
  align-items: center; justify-content: center; padding: 18px;
}
.mw-modal-mask.open { display: flex; }
.mw-modal {
  width: min(480px, 94vw); max-height: 82vh; overflow-y: auto;
  background: linear-gradient(135deg, rgba(0,30,60,.95), rgba(0,20,50,.95));
  border: 1px solid var(--mw-accent); border-radius: 16px; padding: 20px;
  box-shadow: 0 20px 60px rgba(0,10,40,.7);
  animation: mwPop .25s ease;
}
@keyframes mwPop { from { opacity: 0; transform: scale(.94); } to { opacity: 1; transform: none; } }
.mw-modal-close { float: right; cursor: pointer; color: var(--mw-dim); font-size: 18px; line-height: 1; }
.mw-modal-face {
  width: 76px; height: 76px; line-height: 76px; text-align: center; margin: 4px auto 10px;
  border-radius: 50%; font-size: 30px; font-weight: 800; color: #06122b;
  background: radial-gradient(circle at 30% 25%, var(--mw-glow), transparent 60%),
              linear-gradient(135deg, var(--mw-accent), var(--mw-accent-2));
}
.mw-modal-name { text-align: center; font-size: 18px; font-weight: 800; letter-spacing: 2px; }
.mw-modal-tag { text-align: center; font-size: 11.5px; color: var(--mw-cyan); margin: 2px 0 12px; }
.mw-modal-bio { font-size: 13px; color: var(--mw-text); border-top: 1px dashed var(--mw-line); padding-top: 12px; }

/* ---- 音乐按钮 / 提示条 ---- */
.mw-music {
  position: fixed; right: 14px; bottom: 16px; z-index: 150;
  width: 42px; height: 42px; border-radius: 50%; cursor: pointer;
  display: flex; align-items: center; justify-content: center; font-size: 18px;
  color: var(--mw-accent); background: rgba(10, 16, 48, 0.85);
  border: 1px solid var(--mw-line); transition: all .2s;
}
.mw-music:hover { border-color: var(--mw-accent); }
.mw-music.playing { color: var(--mw-cyan); border-color: var(--mw-cyan); animation: mwSpin 3s linear infinite; }
@keyframes mwSpin { to { transform: rotate(360deg); } }
.mw-toast {
  position: fixed; left: 50%; top: 14px; transform: translateX(-50%) translateY(-80px);
  z-index: 300; max-width: 86vw; padding: 10px 18px; font-size: 13px;
  border-radius: 999px; color: var(--mw-text); pointer-events: none;
  background: rgba(8, 12, 40, 0.95); border: 1px solid var(--mw-accent);
  box-shadow: 0 8px 24px rgba(0,10,40,.5); transition: transform .3s ease;
}
.mw-toast.show { transform: translateX(-50%) translateY(0); }
.mw-toast.err { border-color: #ff6b81; color: #ffd9df; }

@media (max-width: 520px) {
  .mw-title { font-size: 24px; letter-spacing: 8px; }
  .mw-side-grid { grid-template-columns: 1fr; }
  .mw-duo { grid-template-columns: 1fr; }
}
</style>
</head>
