// 键盘 F5（笔记本常为 Fn+F5）= 启动开发服务并打开独立调试 Chrome。
// Chrome 使用独立 profile 和 CDP 9225；Shift+F5 会停止开发服务并还原 YAML。
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动开发环境",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000/",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "启动开发服务",
      "postDebugTask": "结束开发环境",
      "userDataDir": "${workspaceFolder}/.vscode/chrome-debug-profile",
      "runtimeArgs": ["--remote-debugging-port=9225"],
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "src://tavern_helper_template/*": "${workspaceFolder}/*",
        "webpack://tavern_helper_template/./*": "${workspaceFolder}/*",
        "webpack://tavern_helper_template/*": "${workspaceFolder}/*",
        "webpack:///*": "${workspaceFolder}/*"
      }
    }
  ]
}
